From 04c7af631d26e4935ddce7e625f4765488a9161e Mon Sep 17 00:00:00 2001
From: Adam Paquette <acpaquette@usgs.gov>
Date: Thu, 27 Aug 2026 16:18:30 -0600
Subject: [PATCH] Fix setup.py to properly install when running pip install

---
 setup.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/setup.py b/setup.py
index 4d036b7..e41d7b5 100644
--- a/setup.py
+++ b/setup.py
@@ -3,6 +3,7 @@
 import os
 import sys
 from setuptools import setup, find_packages, Extension
+from setuptools.command.build_py import build_py
 
 NAME = "Ale"
 VERSION = "1.3.0"
@@ -28,6 +29,11 @@ ale_c_module = Extension(
     include_dirs=[os.path.join(conda_path, "include/eigen3"), "include/"]
 )
 
+class BuildPy(build_py):
+    def run(self):
+        self.run_command('build_ext')
+        super(build_py, self).run()
+
 setup(
     name=NAME,
     version=VERSION,
@@ -48,4 +54,7 @@ setup(
         ],
     },
     ext_modules=[ale_c_module],
+    cmdclass={
+        'build_py': BuildPy,
+    },
 )
-- 
